<?xml version="1.0"?>
<!-- MASS MODEL: total 2.3 kg = 20 servos (IDs 1-6,17-20: 40.3 g; IDs 7-16: 52.8 g; modelled as point masses at each joint pivot, in the child link) + 3x18650 cells (50 g, upright, rear of body, assumed position) + remaining mass (shell, mainboards, wiring) distributed by convex-hull volume. -->
