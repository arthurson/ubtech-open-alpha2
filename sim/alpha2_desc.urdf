    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

  <!-- Accelerometer on the head mainboard, lying flat (axes aligned with the head frame: x fwd, y left, z up). Position ASSUMED = head link centre of mass. No IMU/gyro on this robot. -->
  <link name="accel_link"/>
  <joint name="accel_joint" type="fixed">
    <parent link="head_pitch_link"/>
    <child link="accel_link"/>
    <origin xyz="0.00142943 -0.0016621 0.038033" rpy="0 0 0"/>
