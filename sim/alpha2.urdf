<?xml version="1.0"?>
<!-- Alpha2 full 20-DOF URDF (sim-ready, primitives, no external meshes)
  來源:
  - C:/Users/user/Desktop/alpha2/Alpha2_pc/Robot/alpha2.xml (ID/Axis/Offset/InitAngle)
  - C:/Users/user/Desktop/alpha2/Alpha2_pc/Robot/alpha2.FBX (外觀mesh, pivot量link長用, 此檔先用box代替, 之後可換<mesh filename>)
  - ubtech-open-alpha2-beta5/scripts/ubx_walk_humanize.py CAL限位 + HOME pose
  - ubtech-open-alpha2-beta5/scripts/ubx_anatomy.py 關節中文名
  - sdk-module/hardware-direct/.../DirectChestController.java cmd3[20B+time]/cmd5單軸
  座標: x前 y左 z上, base_link=骨盆中心(離地約0.37m, spawn時自己抬高)
  servo碼<->sim換算(要實機校方向):
    rad = (servo - InitAngle) * pi/180 * SIGN
    SIGN預設+1, 真機上+10步睇下郁啱定反, 反就該軸SIGN=-1
  InitAngle(歸零位): [120,120,120,120,120,120,120,120,65,145,135,120,120,175,95,105,120,120,120,120]
  CAL(servo限位): {1:(5,235),2:(50,210),3:(55,185),4:(5,235),5:(30,190),6:(55,185),7:(100,200),8:(20,220),9:(35,230),10:(35,215),11:(100,190),12:(40,140),13:(20,220),14:(10,205),15:(25,205),16:(50,140),17:(95,125),18:(95,125),19:(75,165),20:(105,155)}
  sim2real注意: 全部clamp入CAL; 開場2s lead-in由HOME沉入首格; 發送間隔>=150ms, 唔好hammer胸板串口; trim(cmd12 EEPROM)唔好亂寫
-->
<robot name="alpha2">

  <!-- ================= BASE / TORSO ================= -->
  <link name="base_link">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.14 0.14 0.08"/></geometry><material name="blue"><color rgba="0.2 0.4 0.8 1"/></material></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.14 0.14 0.08"/></geometry></collision>
    <inertial><mass value="0.8"/><inertia ixx="0.00173" ixy="0" ixz="0" iyy="0.00173" iyz="0" izz="0.00261"/></inertial>
  </link>

  <joint name="waist_fixed" type="fixed">
    <parent link="base_link"/><child link="torso_link"/><origin xyz="0 0 0.11" rpy="0 0 0"/>
  </joint>

  <link name="torso_link">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.15 0.20 0.22"/></geometry><material name="blue"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.15 0.20 0.22"/></geometry></collision>
    <inertial><mass value="1.0"/><inertia ixx="0.00737" ixy="0" ixz="0" iyy="0.00591" iyz="0" izz="0.00521"/></inertial>
  </link>

  <!-- ================= RIGHT ARM (ID 1,2,3,17) ================= -->
  <!-- ID1 R肩上下 pitch Y, Init120 CAL5-235 -->
  <joint name="j1_r_shoulder_pitch" type="revolute">
    <parent link="torso_link"/><child link="r_shoulder_link"/><origin xyz="0 -0.10 0.08" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.0071" upper="2.0071" effort="4.0" velocity="6.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>
  <link name="r_shoulder_link">
    <visual><origin xyz="0 0 -0.02" rpy="0 0 0"/><geometry><box size="0.05 0.05 0.04"/></geometry><material name="white"><color rgba="0.9 0.9 0.9 1"/></material></visual>
    <collision><origin xyz="0 0 -0.02" rpy="0 0 0"/><geometry><box size="0.05 0.05 0.04"/></geometry></collision>
    <inertial><mass value="0.08"/><inertia ixx="0.000028" ixy="0" ixz="0" iyy="0.000028" iyz="0" izz="0.000033"/></inertial>
  </link>

